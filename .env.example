# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://rounds:rounds@localhost:5433/rounds

# AWS: use your own IAM user's profile (aws configure --profile <name>).
AWS_REGION=us-east-1
AWS_PROFILE=
# false = fully offline: keyword classifier and template replies, no Bedrock calls.
LLM_ENABLED=true
# Check current IDs: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STRONG=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Leave the key empty to use the browser's built-in voice instead.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL_LIVE=eleven_turbo_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_AUDIO_TAGS=false

# Speech-to-text runs in the browser in V1.
STT_PROVIDER=browser
STT_COMMIT_SILENCE_MS=1200

NLM_LOOKUP_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# Iteration 2
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
S3_BUCKET=
