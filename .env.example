# Copy to .env and fill in. Never commit .env.
# The team shares a filled-in copy directly; the same file is the GitHub secret APP_ENV
# that CI copies to the server. See infra/README.md.

DATABASE_URL=postgresql+psycopg://rounds:rounds@localhost:5433/rounds

# AWS: the shared laptop key (app stack output LaptopUserName) goes here, so no AWS setup is
# needed. Or leave both keys empty and set AWS_PROFILE to your own profile.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
# false = fully offline: keyword classifier and template replies, no Bedrock calls.
LLM_ENABLED=true
# Check current IDs: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STRONG=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Leave the key empty and the token route reports that transcription is not configured.
# The key stays on the server. The browser receives a single-use token instead.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL_LIVE=eleven_turbo_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_AUDIO_TAGS=false

# Scribe commits a turn after this much silence. The threshold is how sure the detector must be.
STT_VAD_SILENCE_SECS=1.2
STT_VAD_THRESHOLD=0.4

NLM_LOOKUP_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# Iteration 2
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
S3_BUCKET=
