#
# Policy checks for infra/cloudformation/*.yaml, run in CI with AWS CloudFormation Guard:
#   cfn-guard validate --data infra/cloudformation --rules infra/guard
# cfn-lint checks that templates are valid CloudFormation; these rules check that they keep the
# security choices recorded in each template's "must" metadata.
#

# ---------------------------------------------------------------- S3
let buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]

rule s3_buckets_encrypted_and_private when %buckets !empty {
    %buckets.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm IN ['AES256', 'aws:kms']
        <<Every bucket must be encrypted at rest>>
    %buckets.Properties.PublicAccessBlockConfiguration {
        BlockPublicAcls == true
        BlockPublicPolicy == true
        IgnorePublicAcls == true
        RestrictPublicBuckets == true
        <<Every bucket must block all public access>>
    }
}

let bucket_policies = Resources.*[ Type == 'AWS::S3::BucketPolicy' ]

rule s3_bucket_policies_require_tls when %bucket_policies !empty {
    %bucket_policies {
        some Properties.PolicyDocument.Statement[*] {
            Effect == 'Deny'
            Condition.Bool.'aws:SecureTransport' IN ['false', false]
                <<Bucket policies must deny requests without TLS>>
        }
    }
}

# ---------------------------------------------------------------- RDS
let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]

rule rds_encrypted_and_kept when %databases !empty {
    %databases {
        Properties.StorageEncrypted == true
            <<The database must be encrypted at rest>>
        DeletionPolicy IN ['Snapshot', 'Retain']
            <<Deleting the stack must snapshot or keep the database>>
    }
}

# ---------------------------------------------------------------- Network
let sg_with_ingress = Resources.*[ Type == 'AWS::EC2::SecurityGroup'
                                   Properties.SecurityGroupIngress exists ]

rule no_ingress_from_anywhere when %sg_with_ingress !empty {
    %sg_with_ingress.Properties.SecurityGroupIngress[*] {
        CidrIp not exists or CidrIp != '0.0.0.0/0'
        CidrIpv6 not exists or CidrIpv6 != '::/0'
        <<Security groups must never allow ingress from the whole internet>>
    }
}

let sg_ingress_rules = Resources.*[ Type == 'AWS::EC2::SecurityGroupIngress' ]

rule no_standalone_ingress_from_anywhere when %sg_ingress_rules !empty {
    %sg_ingress_rules.Properties {
        CidrIp not exists or CidrIp != '0.0.0.0/0'
        CidrIpv6 not exists or CidrIpv6 != '::/0'
        <<Security group rules must never allow ingress from the whole internet>>
    }
}

# ---------------------------------------------------------------- EC2
let instances = Resources.*[ Type == 'AWS::EC2::Instance' ]

rule ec2_imdsv2_and_encrypted_disks when %instances !empty {
    %instances.Properties {
        MetadataOptions.HttpTokens == 'required'
            <<Instances must require IMDSv2>>
        BlockDeviceMappings[*].Ebs.Encrypted == true
            <<Instance volumes must be encrypted>>
    }
}

# ---------------------------------------------------------------- IAM
let iam_with_inline = Resources.*[ Type IN ['AWS::IAM::Role', 'AWS::IAM::User']
                                   Properties.Policies exists ]

rule iam_no_full_wildcard_actions when %iam_with_inline !empty {
    %iam_with_inline.Properties.Policies[*].PolicyDocument.Statement[*] {
        when Effect == 'Allow' {
            Action[*] != '*'
                <<No IAM statement may allow every action>>
        }
    }
}

let managed_policies = Resources.*[ Type == 'AWS::IAM::ManagedPolicy' ]

rule iam_managed_policies_no_full_wildcard when %managed_policies !empty {
    %managed_policies.Properties.PolicyDocument.Statement[*] {
        when Effect == 'Allow' {
            Action[*] != '*'
                <<No IAM statement may allow every action>>
        }
    }
}

let iam_with_managed = Resources.*[ Type IN ['AWS::IAM::Role', 'AWS::IAM::User']
                                    Properties.ManagedPolicyArns exists ]

rule iam_no_broad_aws_managed_policies when %iam_with_managed !empty {
    %iam_with_managed.Properties.ManagedPolicyArns[*] {
        when this is_string {
            this != /AdministratorAccess|PowerUserAccess|IAMFullAccess/
                <<Never attach admin-level AWS managed policies>>
        }
        when 'Fn::Sub' exists {
            'Fn::Sub' != /AdministratorAccess|PowerUserAccess|IAMFullAccess/
                <<Never attach admin-level AWS managed policies>>
        }
    }
}

# The shared laptop key lives in a .env file, so its permissions must stay application-only.
rule app_permissions_application_only when Resources.AppPermissions exists {
    Resources.AppPermissions.Properties.PolicyDocument.Statement[*].Action[*] != /^(iam|ec2|sts|organizations|cloudformation|ssm|kms|rds):/
        <<AppPermissions is shared with every laptop; keep it to application services>>
}

rule laptop_user_has_only_app_permissions when Resources.LaptopUser exists {
    Resources.LaptopUser.Properties {
        Policies not exists
            <<LaptopUser must not have inline policies; use AppPermissions>>
        ManagedPolicyArns[*] {
            Ref == 'AppPermissions'
                <<LaptopUser may only have AppPermissions attached>>
        }
    }
}

let oidc_roles = Resources.*[ Type == 'AWS::IAM::Role'
                              some Properties.AssumeRolePolicyDocument.Statement[*].Action == 'sts:AssumeRoleWithWebIdentity' ]

rule github_oidc_pinned_to_repo_and_branch when %oidc_roles !empty {
    %oidc_roles.Properties.AssumeRolePolicyDocument.Statement[*] {
        when Action == 'sts:AssumeRoleWithWebIdentity' {
            Condition.StringEquals.'token.actions.githubusercontent.com:sub' exists
                <<GitHub OIDC trust must pin an exact repo and branch (StringEquals on sub)>>
            Condition.StringEquals.'token.actions.githubusercontent.com:aud' == 'sts.amazonaws.com'
            Condition.StringLike not exists
                <<No wildcard (StringLike) matching in the GitHub OIDC trust>>
        }
    }
}

# ---------------------------------------------------------------- CloudFront
let distributions = Resources.*[ Type == 'AWS::CloudFront::Distribution' ]

rule cloudfront_https_only when %distributions !empty {
    %distributions.Properties.DistributionConfig {
        DefaultCacheBehavior.ViewerProtocolPolicy IN ['redirect-to-https', 'https-only']
            <<Viewers must use HTTPS>>
        CacheBehaviors[*].ViewerProtocolPolicy IN ['redirect-to-https', 'https-only']
            <<Viewers must use HTTPS>>
    }
}
